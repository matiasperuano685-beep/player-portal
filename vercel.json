{
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/registro",
      "destination": "/registro.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reengagement",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/support",
      "schedule": "0 21 */2 * *"
    },
    {
      "path": "/api/cron/inactivos",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/seguimiento",
      "schedule": "*/10 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "registro.capiok.me"
        }
      ],
      "destination": "/registro",
      "permanent": false
    }
  ]
}
