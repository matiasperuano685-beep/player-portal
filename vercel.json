{
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/reengagement",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/support",
      "schedule": "0 21 */2 * *"
    }
  ]
}
